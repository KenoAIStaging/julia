+/* Asynchronous interruption.
+
+   An application may abandon a GMP function at an arbitrary instruction,
+   for instance by a longjmp out of a signal handler or out of one of its
+   memory functions (Julia does both to cancel a computation).  The
+   outputs of the abandoned operation then hold unspecified values, and
+   memory may leak, but each mpz_t (including the numerator and
+   denominator of an mpq_t) remains well-formed, so that it may still be
+   read, written as an output, or cleared:
+
+     - ABSIZ (z) <= ALLOC (z), and PTR (z) points to at least ALLOC (z)
+       limbs of live memory;
+     - if ALLOC (z) != 0, the block at PTR (z) was obtained from the
+       memory functions and no other mpz_t owns it (has it as PTR with a
+       nonzero ALLOC).
+
+   Code that updates SIZ, PTR and ALLOC of an mpz_t (or swaps blocks
+   between two of them) does so in an order that keeps these conditions
+   after every store: for instance SIZ is raised only once a block of that
+   size is installed, and a new block is installed under the smaller of
+   the old and new ALLOC.  Where consecutive stores depend on this order,
+   GMP_SIGNAL_FENCE keeps the compiler from merging or reordering them.
+   (A call through the memory function pointers is opaque to the compiler,
+   so stores made before such a call are already complete when it starts.)
+   The interruption is assumed to run on the same thread, so no hardware
+   fence is needed.  */
+#if defined (__GNUC__) || defined (__clang__)
+#define GMP_SIGNAL_FENCE()  __asm__ __volatile__ ("" ::: "memory")
+#elif defined (__STDC_VERSION__) && __STDC_VERSION__ >= 201112L \
+  && ! defined (__STDC_NO_ATOMICS__) && ! defined (__cplusplus)
+#include <stdatomic.h>
+#define GMP_SIGNAL_FENCE()  atomic_signal_fence (memory_order_seq_cst)
+#else
+#define GMP_SIGNAL_FENCE()  do {} while (0)
+#endif
+
+/* Writing an output in place.  The mpz functions listed with
+   __gmp_reset_safe (memory.c) also keep their outputs normalized if
+   abandoned: an output reads as zero while its limbs are being written.
+   MPZ_SIZ_CLEAR stores SIZ = 0 before the first limb is written, and
+   MPZ_SIZ_PUBLISH stores the final, normalized size after the last.  An
+   abandoned output thus holds 0 or a normalized value: the old one, the
+   new one, or an intermediate one in a function built from several such
+   steps.  The output may also be an input, so read the sizes needed
+   before MPZ_SIZ_CLEAR, and reallocate the output before it if its limbs
+   are still needed.  */
+#define MPZ_SIZ_CLEAR(z)						\
+  do {									\
+    SIZ (z) = 0;							\
+    GMP_SIGNAL_FENCE ();						\
+  } while (0)
+#define MPZ_SIZ_PUBLISH(z, n)						\
+  do {									\
+    GMP_SIGNAL_FENCE ();						\
+    SIZ (z) = (n);							\
+  } while (0)
+
 #if WANT_ASSERT
 static inline void *
 _mpz_newalloc (mpz_ptr z, mp_size_t n)
